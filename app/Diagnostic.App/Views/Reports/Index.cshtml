@{
    ViewData["Title"] = "Reports";
}
<div class="page-head">
    <div><h1>Reports</h1><div class="sub">MIS reports from "Reports and Sp Mapping"</div></div>
</div>
<div class="row g-3">
    <div class="col-lg-4">
        <div class="card"><div class="list-group list-group-flush" id="list"><div class="empty">Loading…</div></div></div>
    </div>
    <div class="col-lg-8"><div class="card"><div class="card-body" id="form"><div class="empty">Select a report.</div></div></div></div>
</div>

@section Scripts {
<script>
App.ready(async () => {
    const $ = id => document.getElementById(id);
    let reports;
    try { reports = await fetchReports(); } catch (e) { $('list').innerHTML = `<div class="empty text-danger">${App.esc(e.message)}</div>`; return; }

    async function fetchReports() {
        const res = await fetch(APP.reportBase + '/api/reports', { headers: { Authorization: 'Bearer ' + App.token() } });
        if (!res.ok) throw new Error('Report server: ' + res.status);
        return (await res.json()).filter(r => r.template === 'Tabular');
    }

    $('list').innerHTML = reports.length ? reports.map((r, i) => `<button class="list-group-item list-group-item-action" data-i="${i}">
        <i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>${App.esc(r.name)}</button>`).join('')
        : '<div class="empty">No report is assigned to your role.</div>';

    async function input(p) {
        const id = 'p_' + p.paramName.replace('@@', '');
        const def = p.defaultValue === 'today' ? App.isoDate() : (p.defaultValue || '');
        switch (p.dataType) {
            case 'date': return `<input type="date" class="form-control" id="${id}" value="${def}">`;
            case 'int': case 'decimal': return `<input type="number" class="form-control" id="${id}" value="${App.esc(def)}">`;
            case 'bool': return `<select class="form-select" id="${id}"><option value="">--</option><option value="true">Yes</option><option value="false">No</option></select>`;
            case 'testgroup': return `<select class="form-select" id="${id}">${App.options((await App.lookup('/api/diag/lookups/billing')).testGroups, def, 'All')}</select>`;
            case 'media': return `<select class="form-select" id="${id}">${App.options((await App.lookup('/api/diag/lookups/billing')).medias, def, 'All media')}</select>`;
            default: return `<input class="form-control" id="${id}" value="${App.esc(def)}">`;
        }
    }

    $('list').addEventListener('click', async e => {
        const b = e.target.closest('[data-i]'); if (!b) return;
        $('list').querySelectorAll('.active').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        const r = reports[Number(b.dataset.i)];
        const fields = await Promise.all(r.parameters.map(async p => `<div class="col-md-6"><label class="form-label ${p.isRequired ? 'required' : ''}">${App.esc(p.label)}</label>${await input(p)}</div>`));
        $('form').innerHTML = `<h6 class="fw-bold mb-3">${App.esc(r.name)}</h6><div class="row g-3">${fields.join('')}</div>
            <div class="mt-3 d-flex gap-2"><button class="btn btn-primary" data-run="pdf"><i class="bi bi-file-pdf me-1"></i>View PDF</button>
            <button class="btn btn-outline-success" data-run="csv"><i class="bi bi-filetype-csv me-1"></i>Export CSV</button></div>`;
        $('form').querySelectorAll('[data-run]').forEach(btn => btn.onclick = () => {
            const q = {};
            for (const p of r.parameters) {
                const v = $('p_' + p.paramName.replace('@@', '')).value;
                if (p.isRequired && !v) { App.toast(`${p.label} is required.`, 'warning'); return; }
                q[p.paramName.replace('@@', '')] = v;
            }
            const csv = btn.dataset.run === 'csv';
            if (csv) q.format = 'csv';
            App.report(`/api/reports/run/${encodeURIComponent(r.code)}${App.qs(q)}`, csv ? { download: r.code + '.csv' } : {});
        });
    });
});
</script>
}
