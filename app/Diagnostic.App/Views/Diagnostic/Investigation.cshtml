@{
    ViewData["Title"] = "Investigation Entry";
}
<div class="page-head">
    <div><h1>Investigation Entry</h1><div class="sub">Patient billing for diagnostic tests</div></div>
    <div class="ms-auto d-flex gap-2">
        <div class="form-check form-switch mt-1 me-2">
            <input class="form-check-input" type="checkbox" id="autoPrint"><label class="form-check-label small" for="autoPrint">Print receipt after save</label>
        </div>
        <button class="btn btn-outline-secondary btn-sm" id="btnClear"><i class="bi bi-arrow-counterclockwise me-1"></i>New</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex align-items-center"><i class="bi bi-person me-2"></i>Patient
                <button class="btn btn-sm btn-link ms-auto p-0 d-none" id="btnNewPatient">New patient</button>
            </div>
            <div class="card-body">
                <div class="position-relative mb-3">
                    <input class="form-control" id="patientSearch" placeholder="Search old patient: phone / patient ID / name" autocomplete="off">
                    <div class="search-results d-none" id="patientResults"></div>
                </div>
                <div class="alert alert-info py-2 small d-none" id="patientInfo"></div>
                <div class="row g-2" id="patientForm">
                    <div class="col-3"><label class="form-label">Title</label>
                        <select class="form-select px-2" id="pTitle"><option value="">--</option><option>Mr.</option><option>Mrs.</option><option>Ms.</option><option>Miss</option><option>Master</option><option>Baby</option><option>Dr.</option></select></div>
                    <div class="col-9"><label class="form-label required">Full Name</label><input class="form-control" id="pName"></div>
                    <div class="col-6"><label class="form-label">Gender</label>
                        <select class="form-select" id="pGender"><option>Male</option><option>Female</option><option>Other</option></select></div>
                    <div class="col-6"><label class="form-label">Phone</label><input class="form-control" id="pPhone"></div>
                    <div class="col-3"><label class="form-label">Age (Y)</label><input type="number" min="0" max="150" class="form-control" id="pAgeY" placeholder="Y"></div>
                    <div class="col-2"><label class="form-label">M</label><input type="number" min="0" max="11" class="form-control px-2" id="pAgeM" placeholder="M"></div>
                    <div class="col-2"><label class="form-label">D</label><input type="number" min="0" max="30" class="form-control px-2" id="pAgeD" placeholder="D"></div>
                    <div class="col-5"><label class="form-label">Date of birth</label><input type="date" class="form-control" id="pDob"></div>
                    <div class="col-12"><label class="form-label">Address</label><input class="form-control" id="pAddress"></div>
                </div>
                <div class="mt-2">
                    <label class="form-label" for="media">Media</label>
                    <select class="form-select" id="media"></select>
                    <div class="form-text" id="mediaInfo"></div>
                </div>
                <hr>
                <label class="form-label">Referred By</label>
                <select class="form-select" id="referDoctor"></select>
                <label class="form-label mt-2">Remarks</label>
                <input class="form-control" id="remarks">
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-header d-flex align-items-center"><i class="bi bi-eyedropper me-2"></i>Tests</div>
            <div class="card-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-8 position-relative">
                        <input class="form-control" id="testSearch" placeholder="Type test name or code and press Enter…" autocomplete="off">
                        <div class="search-results d-none" id="testResults"></div>
                    </div>
                    <div class="col-md-4"><select class="form-select" id="package"></select></div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>#</th><th>Name</th><th style="width:70px">Qty</th><th class="text-end">Rate</th><th style="width:80px">Disc(%)</th>
                            <th style="width:140px">Note</th><th class="text-center">Urgent</th><th class="text-end">G.Tk</th><th></th></tr></thead>
                        <tbody id="lines"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-7">
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label">D. Category (discount scheme)</label><select class="form-select" id="discountSetup"></select></div>
                            <div class="col-3"><label class="form-label">Disc (%)</label><input type="number" min="0" max="100" class="form-control" id="extraPct" value="0"></div>
                            <div class="col-3"><label class="form-label">Disc (Tk)</label><input type="number" min="0" class="form-control" id="extraDiscount" value="0"></div>
                            <div class="col-12"><hr class="my-1"></div>
                            <div class="col-4"><label class="form-label">Payment (cash)</label><input type="number" min="0" class="form-control fw-bold" id="payCash" value="0"></div>
                            <div class="col-4"><label class="form-label">Select card</label><select class="form-select" id="cardChannel"></select></div>
                            <div class="col-4"><label class="form-label">Payment (card)</label><input type="number" min="0" class="form-control" id="payCard" value="0"></div>
                            <div class="col-4"><label class="form-label">Card ref. / approval no</label><input class="form-control" id="cardRef"></div>
                            <div class="col-4"><label class="form-label">Select mobile</label><select class="form-select" id="mobileChannel"></select></div>
                            <div class="col-4"><label class="form-label">Payment (mobile)</label><input type="number" min="0" class="form-control" id="payMobile" value="0"></div>
                            <div class="col-4"><label class="form-label">Mobile trx ID</label><input class="form-control" id="mobileRef"></div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <table class="table table-borderless totals mb-2">
                            <tr><td>Sub total</td><td class="money" id="tGross">0.00</td></tr>
                            <tr><td>Discountable (Tk)</td><td class="money text-muted" id="tDiscountable">0.00</td></tr>
                            <tr><td>Discount (-)</td><td class="money" id="tDiscount">0.00</td></tr>
                            <tr><td>VAT (+)</td><td class="money" id="tVat">0.00</td></tr>
                            <tr class="grand"><td>Net payable</td><td class="money" id="tNet">0.00</td></tr>
                            <tr><td>Paid</td><td class="money" id="tPaid">0.00</td></tr>
                            <tr><td>Due amount</td><td class="money text-danger fw-bold" id="tDue">0.00</td></tr>
                        </table>
                        <div class="small text-danger d-none mb-2" id="remarksHint"><i class="bi bi-exclamation-circle me-1"></i>Remarks is required when any discount is applied.</div>
                        <button class="btn btn-primary w-100 py-2" id="btnSave"><i class="bi bi-save me-1"></i>POST (Save Invoice) <span class="small opacity-75">F9</span></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/pages/investigation.js" asp-append-version="true"></script>
}
