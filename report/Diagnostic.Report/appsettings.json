{
  "ConnectionStrings": {
    "DiagnosticDb": "Server=localhost;Database=DiagnosticDb;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Diagnostic.Api",
    "Audience": "Diagnostic",
    "Key": "SET-IN-appsettings.Development.json-OR-ENVIRONMENT"
  },
  "Report": {
    "ShowLetterHead": true
  },
  "Cors": {
    "Origins": [ "http://localhost:5300", "https://localhost:7300" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
